          "title": "a) Definicije",
          "items": [
            {
              "id": "m1",
              "no": 1,
              "question": "Definirajte skup $\\mathbb{C}$.",
              "status": "verbatim",
              "answer_blocks": [
                {
                  "kind": "text",
                  "text": "Skup kompleksnih brojeva je $\\mathbb{C} = \\{a + bi : a, b \\in \\mathbb{R}\\}$."
                }
              ],
              "source": {
                "file": "Materijali/skripta_primjer.pdf",
                "page": 5,
                "quote": "Skup kompleksnih brojeva"
              }
            },
            {
              "id": "m2",
              "no": 2,
              "question": "Odredite inverz kompleksnog broja.",
              "status": "own",
              "answer_blocks": [
                {
                  "kind": "formula",
                  "text": "z^{-1} = \\frac{a - bi}{a^2 + b^2}"
                },
                {
                  "kind": "text",
                  "text": "Za $z = 1 - 2i$ dobije se $\\frac{1 - 2i}{3i}$."
                }
              ]
            },
            {
              "id": "m3",
              "no": 3,
              "question": "Rotacija i modul",
              "status": "verbatim",
              "answer_blocks": [
                {
                  "kind": "formula",
                  "text": "r_O^\\alpha \\circ r_O^\\alpha = r_O^{2\\alpha}"
                },
                {
                  "kind": "list",
                  "items": [
                    "$|z| = \\sqrt{a^2 + b^2}$",
                    "$\\overline{z} = a - bi$",
                    "obični redak bez formule"
                  ]
                }
              ],
              "source": {
                "file": "Materijali/skripta_primjer.pdf",
                "page": 6,
                "quote": "Rotacija je izometrija"
              }
            }
          ]
        },
