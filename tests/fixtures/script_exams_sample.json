           "source": {"file": "Bilješke/stranica_2.jpeg", "page": 1, "quote": "Rotacija je izometrija.", "handwritten": true}},
          {"id": "u1q6", "no": 6, "question": "Izračunajte kompoziciju $s_p \\circ s_p$.", "status": "own",
           "answer_blocks": [
             {"kind": "text", "text": "Kompozicija osne simetrije sa samom sobom je identiteta."},
             {"kind": "hint", "caption": "Podsjetnik", "text": "Svaka točka se dvaput zrcali preko istog pravca i vraća se na početno mjesto."}
           ]}
        ]}
