          {"id": "u1q1", "no": 1, "question": "Definirajte osnu simetriju.", "status": "verbatim",
           "answer_blocks": [
             {"kind": "text", "text": "Osna simetrija s obzirom na pravac $p$ je preslikavanje ravnine koje svakoj točki $T$ pridružuje točku $T'$."},
             {"kind": "formula", "text": "|TN| = |T'N|"},
             {"kind": "hint", "caption": "Rješenje točaka", "text": "Uvrsti vrijednost u formulu i izračunaj $f(x)$.\n\nPar $(x, f(x))$ je jedna točka grafa."}
           ],
           "source": {"file": "Materijali/skripta_primjer.pdf", "page": 1, "quote": "Osna simetrija s obzirom na pravac p je preslikavanje ravnine"}},
          {"id": "u1q2", "no": 2, "question": "Navedi primjer osno simetričnog lika.", "status": "own",
           "answer_blocks": [{"kind": "text", "text": "Jednakokračan trokut: os simetrije je simetrala osnovice."}]},
          {"id": "u1q3", "no": 3, "question": "Definirajte inverziju.", "status": "none"},
          {"id": "u1q5", "no": 4, "question": "Definirajte translaciju.", "status": "verbatim",
           "answer_blocks": [{"kind": "text", "text": "Translacija je izometrija koja svaku točku pomiče za isti vektor."}],
           "source": {"file": "Materijali/skripta_primjer.pdf", "page": 2, "quote": "Translacija je izometrija koja svaku točku pomiče"}}
        ]},
        {"title": "b) Svojstva", "items": [
